// WireScope Resource Script. UTF-8 (code page 65001)
#pragma code_page(65001)
#include <winres.h>
#include "resource.h"

LANGUAGE LANG_NEUTRAL, SUBLANG_NEUTRAL

IDI_APP ICON "icon.ico"
IDR_DRIVER_IMAGE RCDATA "WireScope.bmp"

1 RT_MANIFEST "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 2,0,0,0
 PRODUCTVERSION 2,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "Marek Wesołowski - wesmar"
            VALUE "FileDescription", "WireScope - network packet analyzer, per-program traffic monitor, firewall and impairment simulator"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "WireScope"
            VALUE "LegalCopyright", "© 2026 Marek Wesołowski - wesmar"
            VALUE "OriginalFilename", "WireScope.exe"
            VALUE "ProductName", "WireScope"
            VALUE "ProductVersion", "2.0.0.0"
            VALUE "Comments", "https://github.com/wesmar/WireScope"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// User-visible strings (English, the reference for language\<code>.lng files).
#include "lang/en.rc"
